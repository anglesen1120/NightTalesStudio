# Local development settings (09.1.1-T2, extended by 11.1.1-T1). Copy to .env (git-ignored) and edit.
# These are local-only defaults, never used outside this machine.
# Parsed by tools/dev/*.sh as docker-compose-style dotenv: KEY=VALUE, no shell code is executed.
# Set POSTGRES_PASSWORD to your own value: tools/dev/db-init.sh refuses the value below.

# --- Database (native postgresql@17 on 127.0.0.1:5432, 09.1.1-T2) ---
POSTGRES_DB=nighttales
POSTGRES_USER=nighttales
POSTGRES_PASSWORD=change-me-local

# --- Application hosts (11.1.1-T1, tools/dev/up.sh) ---
ASPNETCORE_ENVIRONMENT=Development
# The browser origin of this deployment (Development accepts an http loopback origin).
APP__PUBLICORIGIN=http://localhost:4200
# Dev-only host ports, one row per listener; up.sh exits 1 naming a port that is already taken. On macOS
# with AirPlay Receiver on, ControlCenter holds *:5000, so give DEV_API_PORT a free port there (5100).
DEV_API_PORT=5000
DEV_WORKER_HEALTH_PORT=8082
MOCK_PORT=8090
DEV_WEB_PORT=4200
DEV_STORAGE_PORT=8333
DEV_STORAGE_VOLUME_PORT=8084
DEV_MAIL_SMTP_PORT=1025
DEV_MAIL_UI_PORT=8025
# Seconds the health loop waits for every endpoint after the hosts are launched. The build runs before
# any host (and the emulators) start, so it never eats this timeout; raise the row only if a host's cold
# start-up is slow.
DEV_HEALTH_TIMEOUT=90

# --- Render node mock (11.1.2-T1) ---
# The key the Worker sends and the mock accepts; both sides read this pair (D13/F26).
MOCK_API_KEY=dev-mock-api-key-local
RENDER_NODE_MOCK_API_KEY=dev-mock-api-key-local
# Serve one named contract fixture (blank = the mock's default), and its render length in seconds.
MOCK_FIXTURE=
MOCK_RENDER_SECONDS=20

# --- Dev-only key material (11.1.1-T1) ---
# tools/dev/up.sh generates throwaway Auth/DataProtection material into .nts/dev/config on the first
# run (an ES256 signing key, a DP_KEK PFX and its password file) and exports it to Api and Worker;
# nothing is committed and nothing is reused outside this machine. The row below is the KEK password
# the native path and the optional compose api/worker both use, so the generated PFX stays readable.
# up.sh refuses to start (exit 2) when this row no longer matches the password file it generated.
DEV_KEK_PASSWORD=change-me-local-dp-kek

# --- Optional Compose stack (11.1.1-T1) ---
# docker-compose.yml runs the api/worker containers as NTS_COMPOSE_UID/NTS_COMPOSE_GID. The DP_KEK PFX
# in .nts/dev/config is owner-only (umask 077, mode 0600) and a bind mount keeps the host ownership,
# so set these to the numbers from `id -u` / `id -g` of the user that owns the checkout — on a
# workstation and on a CI runner alike. Otherwise the containers cannot read the key and fail at
# start-up. If they are unset the image's app user (1654) is used, which is only correct for a
# service that does not need the key. Never used by the native path.
# NTS_COMPOSE_UID=1654
# NTS_COMPOSE_GID=1654

# --- Local object storage (11.1.1-T2 creates the buckets; loopback values) ---
STORAGE_ENDPOINT=http://127.0.0.1:8333
STORAGE_ACCESS_KEY=dev
STORAGE_SECRET_KEY=dev-secret-local
STORAGE_REGION=us-east-1
STORAGE_BUCKET_MEDIA=nt-media-dev
STORAGE_BUCKET_PUBLIC=nt-public-dev
STORAGE_BUCKET_MUSIC=nt-music-dev

# --- Local mail sink (11.1.1-T2 maps these to Email__Smtp__*/Email__From__Address for the hosts) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=dev
SMTP_PASSWORD=dev-secret-local
SMTP_FROM=dev@nighttales.local
