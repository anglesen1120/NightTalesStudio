# Secrets — API keys live only on this machine
config.toml
*.env
.env*
!.env.example
# Runtime state: $NTS_HOME = <repo>/.nts (01 CR-11, DEC-5): clones, venvs, weights, logs, media, rendered config
.nts/

# Generated media and model files
output/
storage/
models/
# 09.7.2-T1 (09 README BD10): C# namespaces named Storage/ are source, not generated media. The
# `storage/` pattern above targets the runtime output dir (11 D14 keeps dev runtime state in .nts/);
# develop already tracks storage-named source dirs, so keep the code ones addable.
!src/**/Storage/
!tests/**/Storage/
*.mp3
*.wav
*.mp4

# Python / tooling
.venv/
__pycache__/
.DS_Store

# --- 01.1.2-T1 (README F16, D1) ---
# Env files: real ones are ignored above (*.env, .env*); templates are env.example, except the root .env.example (09 W3 CR-36)
# Images
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.heic
# 05.2.3-T1: rectangle-only Shorts overlay mock (no third-party content)
!trial/fixtures/shorts-overlay-1080x1920.png
# Other audio / video
*.m4a
*.aac
*.flac
*.ogg
*.opus
*.wma
*.mov
*.webm
*.mkv
