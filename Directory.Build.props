<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- 09.9.4-T1 (09 README W10): the dependency-vulnerability gate. `all` audits the transitive graph
         too, and `high` is the level the CI step blocks on. The four audit warnings are kept out of
         `TreatWarningsAsErrors` on purpose: promoting them would fail every restore the moment a high
         advisory exists, which would make the reviewed, time-boxed allow-list of
         tools/ci/check-vulnerable.py unreachable (it is the only sanctioned way to accept one, plan
         §11's rollback note). The restore still prints the advisory; the CI step is the blocking gate. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>high</NuGetAuditLevel>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
