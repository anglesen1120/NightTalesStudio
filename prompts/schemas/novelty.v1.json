{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novelty.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["scores"],
  "properties": {
    "scores": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "max_overlap_episode_id", "score", "fit", "hook_strength", "reason"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "max_overlap_episode_id": { "type": ["string", "null"] },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "fit": { "type": "number", "minimum": 0, "maximum": 1 },
          "hook_strength": { "type": "number", "minimum": 0, "maximum": 1 },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
