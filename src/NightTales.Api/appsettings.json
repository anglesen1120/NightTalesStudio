{
  "App": {
    "PublicOrigin": "http://localhost:4200"
  },
  "Storage": {
    "PublicBaseUrl": "",
    "RequireHttps": true
  },
  "Catalog": {
    "PublicCacheSeconds": 3600
  },
  "Auth": {
    "Jwt": {
      "Audience": "nts-api"
    },
    "Access": {
      "AdminTokenMinutes": 5,
      "UserTokenMinutes": 15,
      "ClockSkewSeconds": 30
    },
    "Session": {
      "OwnerAbsoluteHours": 12,
      "OwnerIdleMinutes": 30,
      "UserAbsoluteDays": 14
    },
    "Refresh": {
      "CookieName": "__Secure-nts_rt"
    }
  },
  "Registration": {
    "Mode": "closed"
  },
  "Security": {
    "BreachedPasswords": {
      "Mode": "list",
      "TopListSize": 100000
    }
  },
  "LegalDocuments": {
    "Current": {
      "Tos": "v1",
      "Privacy": "v1"
    }
  }
}
