{
  "OpenAi": {
    // Text rates per 1M tokens, read 2026-09-23 from https://developers.openai.com/api/docs/pricing
    // (02 README O3). A changed number inserts a new price_versions row at the next start-up.
    // Inputs above SurchargeThresholdTokens cost 2x input and 1.5x output for the whole request.
    "Pricing": {
      "SurchargeThresholdTokens": 272000,
      // 02.7.2-T2 (02 CR-4/T55, README W1: $10 / 1k calls): the flat fee of one OpenAI web-search call, seeded
      // into price_versions.rates.web_search_call. The source-search bound multiplies it by SourceFinder:MaxSearchCalls.
      "WebSearchCallUsd": 0.01,
      "Models": {
        "gpt-6-luna": { "In": 0.10, "Cached": 0.01, "CacheWrite": 0.125, "Out": 0.50 },
        "gpt-6-sol": { "In": 2.00, "Cached": 0.20, "CacheWrite": 2.50, "Out": 10.00 }
      }
    }
  },
  "Story": {
    "DailyGenerationLimit": 5,
    "LimitWindowHours": 24,
    // 02.6.2-T1 (02 README D21): the single revision pass, read by the worst-case reserve the Api takes at dispatch.
    // MaxRevisions is 0 or 1; a disabled stage reserves nothing for the revision and its review #2.
    "Revision": { "Enabled": true, "MaxRevisions": 1, "MinTextSimilarity": 0.6 },
    // 02.3.3-T1 (02 README T29/D8): the true-crime attestation. AttestationVersion is the single accepted
    // text version an approval tick must name (`ta.v1` ships in prompts/shared/attestation.ta.v1.{vi,en}.md;
    // a wording change is a new version, and every stored tick of the old one stops being accepted).
    // MinCitedSources is the F13 floor of distinct fetched sources each cited by a kept fact.
    "TrueCrime": { "AttestationVersion": "ta.v1", "MinCitedSources": 2 },
    // Story quality checker thresholds (02.3.4-T1). Every key is required: a missing key fails the start-up.
    "Quality": {
      "LengthTolerance": 0.15,
      "MinHookTokens": 3,
      "MaxHookSentences": 3,
      "KeywordsPerSegment": [ 1, 2 ],
      "KeywordsPerMinute": 6,
      "RepeatedSentenceMinTokens": 12,
      "MaxInternalShingleShare": 0.25,
      "NameHeuristic": true
    }
  },
  "Similarity": {
    // 02.5.6-T2 (CR-10, 2026-10-17): measured on prompts/fixtures/similarity/sample-set.v1.json (80 samples); the report
    // tests/NightTales.Domain.UnitTests/Stories/Similarity/Calibration/similarity-calibration-report.json is the evidence.
    "WarnAbove": 0.02,
    "BlockAbove": 0.45,
    // 02.5.3-T2 (02 README D7/F18): the fact-sheet verbatim-copy threshold a fact statement is scored against its
    // cited sources. It repeats the in-code Domain default, so it is an optional key; a value outside 0..1 fails the boot.
    "FactOverlapBlock": 0.05,
    "MinTokens": 50,
    "N": { "vi": 14, "en": 14 },
    "Corpus": { "MaxSourceTexts": 10, "MaxSourceTextChars": 300000, "MaxPastEpisodes": 50 },
    "Perf": { "BudgetMs": 163 }
  },
  "Research": { "FactSheet": { "CopiedFactThreshold": 0.05 } },
  "Autopilot": {
    // 02.8.2-T1 (plan §3.3): the auto-approval gate's thresholds and its calibration switch. Every value repeats
    // the in-code default, including DryRun = true: the gate records a verdict and notifies the owner, and nothing
    // is approved until the owner flips it after reading the 02.8.2-T3 dry run. `strict` is a partial overlay on
    // `default` (an unnamed key inherits), and a series with no `gate_thresholds_ref` resolves to `default`.
    "Gates": {
      "DryRun": true,
      "DryRunMaxEpisodes": 10,
      "Profiles": {
        "default": {
          "Story": {
            "MinMeanReviewScore": 3.5,
            "MinDimensionScore": 3.0,
            "MaxRevisions": 1,
            "MaxSourceSimilarity": 0.05,
            "MaxPastEpisodeSimilarity": 0.10,
            "AllowedContentWarnings": ["violence", "death", "crime", "supernatural", "disturbing"]
          },
          "Video": { "DurationTolerance": 0.05, "LoudnessMinLufs": -16, "LoudnessMaxLufs": -14 },
          // 02.8.2-T2 (plan §3.3): the content gate's thresholds — check 7 (moderation) and check 8 (real-world
          // framing). Every value repeats the in-code default. `MaxScore` is the highest accepted 0…1 score per
          // omni category: a flagged category with no entry here fails (fail closed), and a score above its entry
          // fails even when the provider did not flag it. `IncidentWords` is the vi + en starter list T3 tunes; a
          // date or year alone is not a signal, only a date and one of these words in the same segment.
          "Moderation": {
            "BlockedCategories": ["sexual/minors", "self-harm/instructions", "illicit/violent", "hate/threatening"],
            "MaxScore": { "harassment": 0.5, "hate": 0.3, "illicit": 0.5, "self-harm": 0.3,
                          "sexual": 0.5, "violence": 0.6, "violence/graphic": 0.3 }
          },
          "RealWorld": {
            "RequireIncidentCoOccurrence": true,
            "IncidentWords": [ "vụ án", "vụ thảm sát", "án mạng", "giết người", "tai nạn", "vụ nổ", "bắt giữ",
                               "kết án", "tù chung thân", "tử hình", "mất tích", "tự tử",
                               "murder case", "homicide", "massacre", "shooting", "arrested", "convicted",
                               "sentenced", "life sentence", "death penalty", "went missing", "suicide" ]
          }
        },
        "strict": {
          "Story": {
            "MinMeanReviewScore": 4.0,
            "MinDimensionScore": 3.5,
            "MaxSourceSimilarity": 0.03,
            "MaxPastEpisodeSimilarity": 0.05
          }
        }
      }
    },
    // 02.8.1-T1 (plan §3.2/§7.1): how many episode ideas one run asks for and the per-field limits IdeaValidator
    // enforces. Every value repeats the in-code default. The step's model, effort and timeout are the OpenAi
    // section's (OpenAi:Models:Ideas, OpenAi:Effort:Ideas, OpenAi:RequestTimeout:Ideas); its max_output_tokens is
    // price_versions.limits.ideas.max_output_tokens, never a key here (README T56).
    "Ideas": {
      "Count": 5,
      "MaxCount": 10,
      "Limits": { "TitleChars": 100, "LoglineChars": 300, "HookChars": 300, "SettingChars": 120, "MinBeats": 3, "MaxBeats": 8 },
      // 02.8.1-T2 (plan §3.4/F32): the novelty thresholds ([WARN] first guesses, calibrated in the 02.8.2-T3 dry
      // run), the corpus cap, the four pick weights and the content-policy pre-check. The judge call's model,
      // effort and timeout are the OpenAi section's (OpenAi:Models:Novelty, OpenAi:Effort:Novelty,
      // OpenAi:RequestTimeout:Novelty); its max_output_tokens is price_versions.limits.novelty.max_output_tokens
      // (fallback 400), never a key here (README T56).
      "Novelty": { "CorpusEpisodes": 100, "LexicalMax": 0.35, "JudgeMax": 0.70 },
      "Weights": { "Novelty": 0.45, "Fit": 0.30, "Hook": 0.25, "Variety": 0.35 },
      // F31/F33: "word" is the only accepted BannedThemeMatchMode (whole-word, diacritics kept). CrimeNouns and
      // FramingLexicon are data the true-crime framing check matches; banned themes are per-series rows, not keys.
      "Policy": {
        "ModerationEnabled": true,
        "FailClosed": false,
        "BannedThemeMatchMode": "word",
        "CrimeNouns": [ "giết người", "án mạng", "tự tử", "bắt cóc", "cướp", "hiếp dâm", "tai nạn", "mất tích",
                        "thi thể", "hung thủ", "sát nhân", "murder", "homicide", "suicide", "kidnapping", "robbery",
                        "rape", "assault", "disappearance", "body", "killer", "serial killer", "crime" ],
        "FramingLexicon": [ "câu chuyện có thật", "dựa trên sự thật", "based on a true story", "true crime" ]
      }
    },
    // 02.8.4-T1 (plan §10 item 10): the variety guard's window, template window, tag-share cap and rotation
    // floor. Every value repeats the in-code default ([WARN] first guesses, calibrated by the 02.8.2-T3 dry run);
    // Enabled=false is the rollback recipe (steering only).
    "Variety": { "Enabled": true, "WindowK": 10, "TemplateWindowK": 5, "TagShareMax": 0.40, "RotationMinCount": 3 }
  },
  "Bible": {
    // 02.6.3 plan §3.2/§7.1: the content limits GET/PUT /series/{id}/bible enforces, and the proposal job's caps.
    "Limits": { "NarratorNameChars": 80, "NarratorPersonaChars": 1000, "VoiceNotesChars": 1000,
                "MaxCharacters": 30, "MaxPlaces": 30, "MaxRules": 30, "NameChars": 60, "DescriptionChars": 300,
                "RuleChars": 300, "SummaryTitleChars": 100, "SummaryChars": 200, "MaxContentBytes": 65536 },
    "Proposal": { "Enabled": true, "MaxOps": 10, "MaxCharacterOps": 3, "MaxPlaceOps": 3, "MaxRuleOps": 2, "MaxStoryChars": 24000 },
    "Prompt": { "MaxSummaries": 50, "MaxChars": 36000, "MaxVoiceNotesChars": 500, "MaxDescriptionChars": 150,
                "KeepFullSummaryCount": 25, "MaxArrayEntries": 15 },
    "AvoidPlots": { "Max": 25, "MaxCharsPerEntry": 120 }
  },
  "YouTube": {
    // 06.1.2-T1 (06 README D2/D9/D11): the OAuth client map and the Google endpoints of the connect flow.
    // `SecretRef` is a *name* in the secret manager (`nts/<env>/api/YOUTUBE_CLIENT_SECRET`, 11 README A3/A12),
    // never a secret: start-up validation reads no secret, the connect resolves one lazily through
    // ISecretProvider. Every key below carries a non-secret value so the Api and the build-time OpenAPI
    // generator boot with no environment override; staging and prod override `ActiveClientId`, `Clients` and
    // `RedirectUri` with their own project's values (06.1.1-T1 registers `https://<env origin>/api/v1/channels/youtube/callback`
    // at Google, so a deployed origin must match this key).
    "ActiveClientId": "nts-youtube-dev",
    "Clients": {
      "nts-youtube-dev": { "SecretRef": "nts/dev/api/YOUTUBE_CLIENT_SECRET" }
    },
    "RedirectUri": "http://127.0.0.1:5000/api/v1/channels/youtube/callback",
    "Scopes": [
      "https://www.googleapis.com/auth/youtube.upload",
      "https://www.googleapis.com/auth/youtube.readonly"
    ],
    "AuthorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
    "TokenEndpoint": "https://oauth2.googleapis.com/token",
    "RevokeEndpoint": "https://oauth2.googleapis.com/revoke",
    // The YouTube Data API host root: the Google SDK appends its own `youtube/v3/` path to it, so a value must not
    // already carry that path (`https://www.googleapis.com/youtube/v3` would double it).
    "ApiBaseUrl": "https://www.googleapis.com",
    // 06.2.3-T1: the resumable-upload root (G7). Unlike `ApiBaseUrl` it carries its own `upload/youtube/v3/` path
    // and must end in `/`, because the client appends `videos?uploadType=resumable` to it. Google's session URI must
    // live on this URL's scheme, host and port, so it is the only egress target of an upload (D19); the integration
    // suite points it at FakeGoogleServer.
    "UploadBaseUrl": "https://www.googleapis.com/upload/youtube/v3/",
    // 06.2.3-T1 (G7/G8): the resumable upload's tuning. `ChunkSizeBytes` must be a positive multiple of 262144
    // (256 KiB, the granularity every non-final chunk needs) and at most 268435456 (256 MiB); the timeouts are in
    // seconds and `ChunkTimeoutSeconds` covers one chunk request of up to that size.
    "Upload": {
      "ChunkSizeBytes": 10485760,
      "MaxChunkRetries": 3,
      "StartTimeoutSeconds": 30,
      "ProbeTimeoutSeconds": 15,
      "ChunkTimeoutSeconds": 100
    },
    "Pkce": true,
    "OAuthStateMinutes": 10,
    "Http": { "TimeoutSeconds": 15 },
    // 06.3.1-T1 (09 D11): the platform's daily YouTube upload quota in units. It must be at least 1.
    "Quota": { "UnitsPerDay": 100 }
  },
  "Budget": {
    // Platform spend caps in USD (02 D1): spent + open worst-case bounds + the new bound must stay under both.
    // Enabled=false is a test-only kill-switch.
    "Enabled": true,
    "MaxPlatformCostUsdPerDay": 3,
    "MaxPlatformCostUsdPerMonth": 40
  },
  "Sources": {
    // 02.5.1 plan §3.3: the volume caps of the add/retry commands. MaxUrlSourcesPerUserPerDay is a rolling 24 h.
    "MaxPerEpisode": 10,
    "MaxUrlSourcesPerUserPerDay": 30,
    "MaxNoteChars": 3000
  },
  "SourceFinder": {
    // 02.7.2-T2 (02.7 plan §7): the tool-call cap the finder prompt states and the worst-case bound multiplies the
    // per-call fee by, and the byte ceiling of the finder prompt plus its data object (02.7.2-T3 must stay under it).
    // Both repeat the in-code defaults, so the keys are optional; a value outside their bounds fails the boot.
    "MaxSearchCalls": 3,
    "MaxInputBytes": 6000
  },
  "Fetcher": {
    // 02 D11: video and social platforms; matched on the registrable domain and every subdomain. Data: a change is a
    // reviewed PR. Every entry must be a lowercase registrable domain, or the host fails to start.
    "BlockedDomains": [
      "youtube.com", "youtu.be", "youtube-nocookie.com", "tiktok.com", "facebook.com", "fb.watch", "fb.com",
      "instagram.com", "threads.net", "x.com", "twitter.com", "t.co", "reddit.com", "vimeo.com", "dailymotion.com",
      "twitch.tv", "bilibili.com", "zalo.me", "zingmp3.vn"
    ],
    // 02.5.2-T2 (02 D10): the lease API. A lease expires 90 s after it is taken or last extended; a heartbeat moves the end
    // to now + 60 s (never earlier than the current end) but never past MaxLeaseTotalSeconds after the lease was taken;
    // at most 4 tasks are leased at once platform-wide and 1 per registrable domain (fixed by the lease
    // statement). The sweeper keys (SweepIntervalSeconds, MaxAttempts, RequeueBackoffSeconds) live in the Worker's file.
    "LeaseSeconds": 90,
    "HeartbeatSeconds": 60,
    "MaxLeaseTotalSeconds": 300,
    "MaxLeasesPlatformWide": 4,
    "MaxLeasesPerDomain": 1,
    "Internal": {
      // The internal listener (port 8081) is opt-in per deployment: enabled, the host refuses to start without the runtime
      // secret FETCHER_API_TOKEN (11.5.2, never in this file). Loopback unless the container environment says 0.0.0.0.
      "Enabled": false,
      "ListenAddress": "127.0.0.1",
      "ListenPort": 8081,
      "MaxRequestsPerMinutePerWorker": 60,
      "MaxBodyBytes": 1048576
    }
  },
  "Images": {
    // Scene budget (03 README D3). ClipSeconds = 60 / K (K = 6 images per minute); change it together with K in
    // the story prompts (02 D4). A changed value affects new renders only.
    "ClipSeconds": 10,
    "SpareShare": 0.15,
    "SparseShare": 0.7,
    "MaxSkippedShare": 0.10,
    "Model": "gpt-image-2",
    // Unset = the API default "auto" (D9); mirrors ImageRelay:Quality on the node.
    "Quality": "",
    // Image output tokens per image while the price version has no price for Model (D8 placeholder).
    "PlaceholderTokensPerImage": 6000,
    // Render keyword linter (03 README D11, 03.2.2-T1). false stops the name rule — the episode's own fetched
    // source titles and approved facts — and leaves the 02 KeywordRules on; D11's rollback knob.
    "Linter": {
      "NameCorpusEnabled": true
    }
  },
  "App": {
    "PublicOrigin": "http://localhost:4200"
  },
  "Http": {
    "ForwardedHeaders": {
      "KnownNetworks": "",
      "KnownProxies": ""
    }
  },
  "Render": {
    "Client": {
      "AttemptSeconds": 10,
      "TotalSeconds": 30,
      "MaxRetries": 3,
      "CircuitBreaker": {
        "MinimumThroughput": 5,
        "FailureRatio": 1.0,
        "SamplingDurationSeconds": 60,
        "BreakDurationSeconds": 30
      }
    },
    "Download": {
      "IdleSeconds": 60
    },
    "DownloadMaxMinutes": 20,
    "MaxVideoBytes": 2147483648,
    "MaxSubtitleBytes": 2097152,
    // 09.6.3-T1 (BD7): the render poller's cadence and bounds, kept equal to the Worker's values. The Worker
    // binds and validates the section (`ValidateOnStart`); the Api only carries it next to the other keys.
    "PollSeconds": 10,
    "MaxMinutes": 60,
    "QueueAlertMinutes": 360,
    "PollBatchSize": 50,
    "PollParallelism": 4
  },
  "Storage": {
    "PublicBaseUrl": "",
    "RequireHttps": true,
    "ServiceUrl": "http://127.0.0.1:8333",
    "PublicServiceUrl": "http://localhost:8333",
    "Region": "us-east-1",
    "ForcePathStyle": true,
    "AccessKey": "dev",
    "SecretKey": "dev-secret-local",
    "Buckets": {
      "Media": "nt-media-dev",
      "Public": "nt-public-dev",
      "Music": "nt-music-dev"
    },
    "PresignTtlMinutes": 15,
    "TikTokPresignTtlMinutes": 120,
    "HealthMarkerKey": "_health/storage-ready.txt",
    "HealthProbeSeconds": 30
  },
  "Catalog": {
    "PublicCacheSeconds": 3600
  },
  // 09.7.1-T1 (WT56): the retention window of an approved episode's assets. Approve re-stamps every live
  // asset with this window, overwriting the ingest's unapproved stamp; an out-of-range value fails the boot.
  "Assets": {
    "RetentionDays": 30
  },
  "InternalJobs": {
    "AllowedCidrs": []
  },
  "Auth": {
    "Jwt": {
      "Audience": "nts-api"
    },
    "Access": {
      "AdminTokenMinutes": 5,
      "UserTokenMinutes": 15,
      "ClockSkewSeconds": 30
    },
    "Session": {
      "OwnerAbsoluteHours": 12,
      "OwnerIdleMinutes": 30,
      "UserAbsoluteDays": 14
    },
    "Refresh": {
      "CookieName": "__Secure-nts_rt"
    },
    "ActionToken": {
      "PasswordResetMinutes": 60,
      "EmailVerifyHours": 24
    },
    "Mfa": {
      "ChallengeMinutes": 5,
      "MaxAttempts": 5
    }
  },
  "Hubs": {
    "MaxConnectionMinutes": {
      "owner": 5,
      "admin": 5,
      "user": 15
    }
  },
  "Registration": {
    "Mode": "closed"
  },
  "RateLimiting": {
    "Enabled": true,
    "RetryAfterSeconds": 60,
    "Ipv6PrefixLength": 64,
    "Auth": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Paid": { "PermitLimit": 30, "WindowSeconds": 60, "SegmentsPerWindow": 6 },
    "Hub": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Anon": { "PermitLimit": 60, "WindowSeconds": 60 }
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576
    }
  },
  "Security": {
    "BreachedPasswords": {
      "Mode": "list",
      "TopListSize": 100000
    }
  },
  "LegalDocuments": {
    "Current": {
      "Tos": "1.0.0",
      "Privacy": "1.0.0"
    }
  },
  "Email": {
    "From": {
      "Address": "no-reply@nighttales.local",
      "Name": "NightTales"
    },
    "Smtp": {
      "Host": "127.0.0.1",
      "Port": 1025,
      "Security": "None",
      "TimeoutSeconds": 30
    },
    "AddressHashPepper": "nighttales-development-address-pepper"
  },
  "Realtime": {
    "MaxPayloadBytes": 8000,
    "HeartbeatSeconds": 30,
    "RevalidateSeconds": 60,
    "DeliveryQueueCapacity": 1024,
    "DeliveryTimeoutSeconds": 10,
    "ListenerBackoffSeconds": [ 1, 2, 4, 8, 16, 30 ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning"
      }
    }
  },
  "Otlp": {
    "Enabled": true
  },
  "Otel": {
    "SampleRatio": 1.0
  },
  "HealthChecks": {
    "DbTimeoutSeconds": 5
  }
}
