{
  "App": {
    "PublicOrigin": "http://localhost:4200"
  },
  "Storage": {
    "PublicBaseUrl": "",
    "RequireHttps": true
  },
  "Catalog": {
    "PublicCacheSeconds": 3600
  },
  "Auth": {
    "Jwt": {
      "Audience": "nts-api"
    },
    "Access": {
      "AdminTokenMinutes": 5,
      "UserTokenMinutes": 15,
      "ClockSkewSeconds": 30
    },
    "Session": {
      "OwnerAbsoluteHours": 12,
      "OwnerIdleMinutes": 30,
      "UserAbsoluteDays": 14
    },
    "Refresh": {
      "CookieName": "__Secure-nts_rt"
    }
  },
  "Hubs": {
    "MaxConnectionMinutes": {
      "owner": 5,
      "admin": 5,
      "user": 15
    }
  },
  "Registration": {
    "Mode": "closed"
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576
    }
  },
  "Security": {
    "BreachedPasswords": {
      "Mode": "list",
      "TopListSize": 100000
    }
  },
  "LegalDocuments": {
    "Current": {
      "Tos": "v1",
      "Privacy": "v1"
    }
  },
  "Realtime": {
    "MaxPayloadBytes": 8000,
    "HeartbeatSeconds": 30,
    "RevalidateSeconds": 60,
    "DeliveryQueueCapacity": 1024,
    "DeliveryTimeoutSeconds": 10,
    "ListenerBackoffSeconds": [ 1, 2, 4, 8, 16, 30 ]
  }
}
