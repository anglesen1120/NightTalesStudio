<Project Sdk="Microsoft.NET.Sdk">

  <!--
    02.5.2-T3 [DECISION T40]: the fetcher's safety and extraction code, shared by the NightTales.Fetcher host and
    NightTales.Infrastructure. It references Domain only, so the fetcher container never carries EF Core, the OpenAI
    SDK, Hangfire or the storage client (02 README D10; 11 §5.1). The architecture tests enforce this.
  -->
  <ItemGroup>
    <ProjectReference Include="..\NightTales.Domain\NightTales.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ErrorOr" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="SmartReader" />
  </ItemGroup>

  <!--
    02.5.1-T1 (02.5.1 plan §3.1): the IANA/Mozilla public suffix list that decides a source URL's registrable domain.
    Vendored verbatim, MPL-2.0 header intact, embedded so a deployment cannot ship without it.
    `PublicSuffixListProvider` addresses it by this logical name; refresh it with a PR that replaces the file from https://publicsuffix.org/list/public_suffix_list.dat.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Research/public_suffix_list.dat" LogicalName="NightTales.Fetcher.Core.Research.public_suffix_list.dat" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NightTales.Infrastructure.UnitTests" />
    <InternalsVisibleTo Include="NightTales.Fetcher" />
    <InternalsVisibleTo Include="NightTales.Fetcher.UnitTests" />
  </ItemGroup>
</Project>
