{
  "Fetcher": {
    // 02 D11: a defence-in-depth copy of the Api's blocklist (02.5.2-T3 failure table): a stale copy can only block more,
    // never less, because the Api already rejected the task at creation. Every entry is a lowercase registrable domain.
    "BlockedDomains": [
      "youtube.com", "youtu.be", "youtube-nocookie.com", "tiktok.com", "facebook.com", "fb.watch", "fb.com",
      "instagram.com", "threads.net", "x.com", "twitter.com", "t.co", "reddit.com", "vimeo.com", "dailymotion.com",
      "twitch.tv", "bilibili.com", "zalo.me", "zingmp3.vn"
    ],
    "LeaseSeconds": 90,
    "HeartbeatSeconds": 60,
    "MaxLeaseTotalSeconds": 300,
    "MaxLeasesPlatformWide": 4,
    "MaxLeasesPerDomain": 1,
    // The loop's own keys (02.5.2-T3 Design): the idle poll and the supervisor-restart contract (T43).
    "IdlePollMilliseconds": 2000,
    "BusyPollMilliseconds": 500,
    "ConsecutiveFailuresBeforeExit": 5,
    "Internal": {
      // Required: the Api's internal listener, e.g. http://api:8081. The token is FETCHER_API_TOKEN, never this file.
      "BaseUrl": ""
    }
  },
  "Otlp": {
    // The same switch as the Api and the Worker: off unless Otlp:Enabled is true and an endpoint is set.
    "Enabled": false,
    "Endpoint": ""
  },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft": "Warning", "System": "Warning" }
  }
}
