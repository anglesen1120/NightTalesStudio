<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NightTales.Application\NightTales.Application.csproj" />
  </ItemGroup>

  <!--
    09.2.5-T1: the committed `seed/` catalogs must be found at runtime. Only the catalogs the
    Infrastructure seeders read are copied, into the output (preserving the `seed/...` layout the
    `Seed:*File` configuration names), so a host that resolves a relative catalog path against
    AppContext.BaseDirectory finds them in Development, in a published image and under `dotnet run`.
    `Content` items of this project flow transitively to every referencing host and test project.
  -->
  <ItemGroup>
    <Content Include="..\..\seed\catalog.dev.json;..\..\seed\style-templates.v1.json;..\..\seed\voices.v1.json"
             Link="seed\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Hangfire.NetCore" />
    <PackageReference Include="Hangfire.PostgreSql" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <!--
    09.3.1-T1: the bundled breached-password top-list of `Security:BreachedPasswords:Mode = list`.
    It is embedded (not copied) so it cannot be lost at deployment time, and `TopListPasswordChecker`
    addresses it by this exact logical name. Replace the file with the provider's real top-list once its
    terms are confirmed (09.3.1-T2, S); the lookup needs no change.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Identity/Resources/breached-passwords.txt"
                      LogicalName="NightTales.Infrastructure.Identity.Resources.breached-passwords.txt" />
  </ItemGroup>
</Project>
