{
  "App": {
    "PublicOrigin": "http://localhost:4200"
  },
  "Email": {
    "From": {
      "Address": "no-reply@nighttales.local",
      "Name": "NightTales"
    },
    "Smtp": {
      "Host": "127.0.0.1",
      "Port": 1025,
      "Security": "None",
      "TimeoutSeconds": 30
    },
    "AddressHashPepper": "nighttales-development-address-pepper"
  },
  "Registration": {
    "Mode": "closed"
  },
  "Security": {
    "BreachedPasswords": {
      "Mode": "list",
      "TopListSize": 100000
    }
  },
  "LegalDocuments": {
    "Current": {
      "Tos": "v1",
      "Privacy": "v1"
    }
  },
  "Jobs": {
    "Workers": {
      "default": 4,
      "render": 2,
      "publish": 1,
      "email": 1
    },
    "QueuePollSeconds": 5,
    "SchedulePollSeconds": 5,
    "SchemaName": "hangfire"
  },
  "Worker": {
    "HealthPort": 8082
  },
  "RenderNodes": {
    "HealthPollSeconds": 30,
    "DownAfterSeconds": 120,
    "HealthStaleSeconds": 90,
    "DriftAlertPulls": 3
  },
  "Outbox": {
    "PollIntervalSeconds": 5,
    "BatchSize": 20,
    "LeaseMinutes": 5,
    "MaxAttempts": 10
  },
  "Storage": {
    "ServiceUrl": "http://127.0.0.1:8333",
    "PublicServiceUrl": "http://localhost:8333",
    "Region": "us-east-1",
    "ForcePathStyle": true,
    "AccessKey": "dev",
    "SecretKey": "dev-secret-local",
    "Buckets": {
      "Media": "nt-media-dev",
      "Public": "nt-public-dev",
      "Music": "nt-music-dev"
    },
    "PresignTtlMinutes": 15,
    "TikTokPresignTtlMinutes": 120,
    "HealthMarkerKey": "_health/storage-ready.txt",
    "HealthProbeSeconds": 30
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Hangfire": "Warning"
      }
    }
  },
  "Otlp": {
    "Enabled": true
  },
  "Otel": {
    "SampleRatio": 1.0
  },
  "HealthChecks": {
    "DbTimeoutSeconds": 5
  }
}
