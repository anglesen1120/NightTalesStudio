{
  "OpenAi": {
    // 02.2.1-T2 (02 README D7): the text adapter. ApiKey is never committed: set OpenAi__ApiKey from the secret
    // store (required in every environment). BaseUrl is the pinned relay (01 DEC-9); another value is accepted
    // only in Development. Models/Effort/RequestTimeout repeat the in-code defaults so they are reviewable here.
    "BaseUrl": "https://api.aixingialaire.shop/v1",
    "Models": {
      "Writer": "gpt-6-luna", "Review": "gpt-6-luna", "Revision": "gpt-6-luna", "Facts": "gpt-6-luna",
      "Bible": "gpt-6-luna", "Ideas": "gpt-6-luna", "Novelty": "gpt-6-luna", "Finder": "gpt-6-luna"
    },
    "Effort": {
      "Writer": "medium", "Review": "low", "Revision": "low", "Facts": "low",
      "Bible": "low", "Ideas": "low", "Novelty": "low", "Finder": "low"
    },
    "RequestTimeout": {
      "Writer": "00:01:30", "Review": "00:00:45", "Revision": "00:01:30", "Facts": "00:01:00",
      "Bible": "00:00:30", "Ideas": "00:00:30", "Novelty": "00:00:30", "Finder": "00:00:30"
    },
    // 02.4.1-T1 (02 README D12, O7): the free moderation endpoint. Same BaseUrl as the text calls (10 CR-16).
    // Every key has an in-code default; the chunk cap (8,000 chars) is unverified (O7). TimeoutSeconds is TL T21.
    "Moderation": {
      "Model": "omni-moderation-latest",
      "MaxCharsPerChunk": 8000,
      "TimeoutSeconds": 15
    },
    // Text rates per 1M tokens, read 2026-09-23 from https://developers.openai.com/api/docs/pricing
    // (02 README O3). A changed number inserts a new price_versions row at the next start-up.
    // Inputs above SurchargeThresholdTokens cost 2x input and 1.5x output for the whole request.
    "Pricing": {
      "SurchargeThresholdTokens": 272000,
      // 02.7.2-T2 (02 CR-4/T55, README W1: $10 / 1k calls): the flat fee of one OpenAI web-search call, seeded
      // into price_versions.rates.web_search_call. The source-search bound multiplies it by SourceFinder:MaxSearchCalls.
      "WebSearchCallUsd": 0.01,
      "Models": {
        "gpt-6-luna": { "In": 0.10, "Cached": 0.01, "CacheWrite": 0.125, "Out": 0.50 },
        "gpt-6-sol": { "In": 2.00, "Cached": 0.20, "CacheWrite": 2.50, "Out": 10.00 }
      }
    }
  },
  "Story": {
    // 02.6.1-T1: the model review stage of the generate-story job (read by 02.2.2-T3). The review model and effort are
    // OpenAi:Models:Review and OpenAi:Effort:Review above. false skips the stage; existing audit documents stay readable.
    "Review": { "Enabled": true },
    // 02.6.2-T1 (02 README D21): the single revision pass. Models/Effort/RequestTimeout for the revision step are
    // OpenAi:Models:Revision / OpenAi:Effort:Revision / OpenAi:RequestTimeout:Revision above. MaxRevisions is 0 or 1.
    "Revision": { "Enabled": true, "MaxRevisions": 1, "MinTextSimilarity": 0.6 },
    // 02.2.2-T3: per-run deadline in seconds (TL T21; one pass of the paid steps without a revision needs 300 s of
    // it) and the sweeper batch. 02.6.2-T1: the optional single revision pass runs only while the remaining deadline
    // fits the revise call, review #2 and the save margin, so those three costs are keys of their own here. Every
    // value repeats the in-code default so it is reviewable.
    "Job": {
      "TimeoutSeconds": 360,
      "TimeoutSecondsLong": 480,
      "RevisionRequestTimeoutSeconds": 90,
      "ReviewRequestTimeoutSeconds": 45,
      "SaveMarginSeconds": 30
    },
    "Sweeper": { "BatchSize": 200 },
    // Same thresholds as the Api (the Worker now runs StoryQualityChecker at generation time).
    "Quality": {
      "LengthTolerance": 0.15,
      "MinHookTokens": 3,
      "MaxHookSentences": 3,
      "KeywordsPerSegment": [ 1, 2 ],
      "KeywordsPerMinute": 6,
      "RepeatedSentenceMinTokens": 12,
      "MaxInternalShingleShare": 0.25,
      "NameHeuristic": true
    }
  },
  "Similarity": {
    // 02.5.6-T2 (CR-10, 2026-10-17): measured on prompts/fixtures/similarity/sample-set.v1.json (80 samples); the report
    // tests/NightTales.Domain.UnitTests/Stories/Similarity/Calibration/similarity-calibration-report.json is the evidence.
    "WarnAbove": 0.02,
    "BlockAbove": 0.45,
    // 02.5.3-T2 (02 README D7/F18): the fact-sheet verbatim-copy threshold a fact statement is scored against its
    // cited sources. It repeats the in-code Domain default, so it is an optional key; a value outside 0..1 fails the boot.
    "FactOverlapBlock": 0.05,
    "MinTokens": 50,
    "N": { "vi": 14, "en": 14 },
    "Corpus": { "MaxSourceTexts": 10, "MaxSourceTextChars": 300000, "MaxPastEpisodes": 50 },
    "Perf": { "BudgetMs": 163 }
  },
  "Research": { "FactSheet": { "CopiedFactThreshold": 0.05 } },
  "Autopilot": {
    // 02.8.1-T1 (plan §3.2/§7.1): how many episode ideas one run asks for and the per-field limits IdeaValidator
    // enforces. Every value repeats the in-code default. The step's model, effort and timeout are the OpenAi
    // section's (OpenAi:Models:Ideas, OpenAi:Effort:Ideas, OpenAi:RequestTimeout:Ideas above); its
    // max_output_tokens is price_versions.limits.ideas.max_output_tokens, never a key here (README T56).
    "Ideas": {
      "Count": 5,
      "MaxCount": 10,
      "Limits": { "TitleChars": 100, "LoglineChars": 300, "HookChars": 300, "SettingChars": 120, "MinBeats": 3, "MaxBeats": 8 },
      // 02.8.1-T2 (plan §3.4/F32): the novelty thresholds ([WARN] first guesses, calibrated in the 02.8.2-T3 dry
      // run), the corpus cap, the four pick weights and the content-policy pre-check. The judge call's model,
      // effort and timeout are this section's OpenAi keys (OpenAi:Models:Novelty, OpenAi:Effort:Novelty,
      // OpenAi:RequestTimeout:Novelty above); its max_output_tokens is price_versions.limits.novelty.max_output_tokens
      // (fallback 400), never a key here (README T56).
      "Novelty": { "CorpusEpisodes": 100, "LexicalMax": 0.35, "JudgeMax": 0.70 },
      "Weights": { "Novelty": 0.45, "Fit": 0.30, "Hook": 0.25, "Variety": 0.35 },
      // F31/F33: "word" is the only accepted BannedThemeMatchMode (whole-word, diacritics kept). CrimeNouns and
      // FramingLexicon are data the true-crime framing check matches; banned themes are per-series rows, not keys.
      "Policy": {
        "ModerationEnabled": true,
        "FailClosed": false,
        "BannedThemeMatchMode": "word",
        "CrimeNouns": [ "giết người", "án mạng", "tự tử", "bắt cóc", "cướp", "hiếp dâm", "tai nạn", "mất tích",
                        "thi thể", "hung thủ", "sát nhân", "murder", "homicide", "suicide", "kidnapping", "robbery",
                        "rape", "assault", "disappearance", "body", "killer", "serial killer", "crime" ],
        "FramingLexicon": [ "câu chuyện có thật", "dựa trên sự thật", "based on a true story", "true crime" ]
      }
    },
    // 02.8.4-T1 (plan §10 item 10): the variety guard's window, template window, tag-share cap and rotation
    // floor. Every value repeats the in-code default ([WARN] first guesses, calibrated by the 02.8.2-T3 dry run);
    // Enabled=false is the rollback recipe (steering only).
    "Variety": { "Enabled": true, "WindowK": 10, "TemplateWindowK": 5, "TagShareMax": 0.40, "RotationMinCount": 3 }
  },
  "Bible": {
    // 02.6.3 plan §3.2/§7.1: the content limits the api enforces, and the proposal job's caps (this host).
    "Limits": { "NarratorNameChars": 80, "NarratorPersonaChars": 1000, "VoiceNotesChars": 1000,
                "MaxCharacters": 30, "MaxPlaces": 30, "MaxRules": 30, "NameChars": 60, "DescriptionChars": 300,
                "RuleChars": 300, "SummaryTitleChars": 100, "SummaryChars": 200, "MaxContentBytes": 65536 },
    "Proposal": { "Enabled": true, "MaxOps": 10, "MaxCharacterOps": 3, "MaxPlaceOps": 3, "MaxRuleOps": 2, "MaxStoryChars": 24000 },
    "Prompt": { "MaxSummaries": 50, "MaxChars": 36000, "MaxVoiceNotesChars": 500, "MaxDescriptionChars": 150,
                "KeepFullSummaryCount": 25, "MaxArrayEntries": 15 },
    "AvoidPlots": { "Max": 25, "MaxCharsPerEntry": 120 }
  },
  "Facts": {
    // 02.5.3-T1 (02 README D7): the fact-extraction input budget (read by the fact-sheet job in the Worker).
    // Every value repeats the in-code default so it is reviewable here. The per-step model/effort/timeout of
    // the `Facts` step are the OpenAi section's (OpenAi:Models:Facts, OpenAi:Effort:Facts,
    // OpenAi:RequestTimeout:Facts); the call's max_output_tokens comes from the price version, not from here.
    "MaxSources": 10,
    "PerSourceCharCap": 20000,
    "MaxInputTokens": 60000,
    "MaxFacts": 40
  },
  "FactSheet": {
    // 02.5.3-T2 (02 README D7): the per-run deadline of `GenerateFactSheetJob`, in seconds, read by the job. It has
    // an in-code default, so the key is optional; a value outside FactSheetJobOptions' bounds (150..360) fails the
    // Worker's boot. 240 s covers the free moderation call (15 s), the facts call and its one invalid-output retry
    // at `OpenAi:RequestTimeout:Facts` (60 s each) and the plan/save headroom; it stays under the story sweeper's
    // 360 s window, which is what reclaims a run this host left `running` on shutdown.
    "Job": { "TimeoutSeconds": 240 }
  },
  "SourceFinder": {
    // 02.7.2-T2 (02.7 plan §7): the tool-call cap the finder prompt states and the worst-case bound multiplies the
    // per-call fee by, and the byte ceiling of the finder prompt plus its data object (02.7.2-T3 must stay under it).
    // Both repeat the in-code defaults, so the keys are optional; a value outside their bounds fails the boot.
    "MaxSearchCalls": 3,
    "MaxInputBytes": 6000
  },
  "Fetcher": {
    // 02.5.2-T2 (02 D10): the fetch-lease sweeper. A lease that expires with MaxAttempts attempts used fails the task
    // (source_unreachable); an earlier expiry requeues it after RequeueBackoffSeconds. The cron is fixed at every minute;
    // SweepIntervalSeconds documents the contract. Keep MaxAttempts and RequeueBackoffSeconds equal to the Api's values.
    "MaxAttempts": 2,
    "RequeueBackoffSeconds": 30,
    "SweepIntervalSeconds": 60
  },
  "YouTube": {
    // 06.3.1-T1 (09 D11): the platform's daily YouTube upload quota in units; must match the Api.
    "Quota": { "UnitsPerDay": 100 }
  },
  "Budget": {
    // Platform spend caps in USD (02 D1); must match the Api, because dispatch-time checks use the same rule.
    "Enabled": true,
    "MaxPlatformCostUsdPerDay": 3,
    "MaxPlatformCostUsdPerMonth": 40
  },
  "Images": {
    // Scene budget (03 README D3). ClipSeconds = 60 / K (K = 6 images per minute); change it together with K in
    // the story prompts (02 D4). A changed value affects new renders only.
    "ClipSeconds": 10,
    "SpareShare": 0.15,
    "SparseShare": 0.7,
    "MaxSkippedShare": 0.10,
    "Model": "gpt-image-2",
    // Unset = the API default "auto" (D9); mirrors ImageRelay:Quality on the node.
    "Quality": "",
    // Image output tokens per image while the price version has no price for Model (D8 placeholder).
    "PlaceholderTokensPerImage": 6000,
    // Render keyword linter (03 README D11, 03.2.2-T1). false stops the name rule — the episode's own fetched
    // source titles and approved facts — and leaves the 02 KeywordRules on; D11's rollback knob. Must match the
    // Api, because both hosts bind this section.
    "Linter": {
      "NameCorpusEnabled": true
    }
  },
  "App": {
    "PublicOrigin": "http://localhost:4200"
  },
  "Email": {
    "From": {
      "Address": "no-reply@nighttales.local",
      "Name": "NightTales"
    },
    "Smtp": {
      "Host": "127.0.0.1",
      "Port": 1025,
      "Security": "None",
      "TimeoutSeconds": 30
    },
    "AddressHashPepper": "nighttales-development-address-pepper"
  },
  "Registration": {
    "Mode": "closed"
  },
  "Security": {
    "BreachedPasswords": {
      "Mode": "list",
      "TopListSize": 100000
    }
  },
  "LegalDocuments": {
    "Current": {
      "Tos": "1.0.0",
      "Privacy": "1.0.0"
    }
  },
  "Jobs": {
    "Workers": {
      "default": 4,
      "render": 2,
      "publish": 1,
      "email": 1
    },
    "QueuePollSeconds": 5,
    "SchedulePollSeconds": 5,
    "SchemaName": "hangfire"
  },
  "Worker": {
    "HealthPort": 8082
  },
  "Render": {
    "Client": {
      "AttemptSeconds": 10,
      "TotalSeconds": 30,
      "MaxRetries": 3,
      "CircuitBreaker": {
        "MinimumThroughput": 5,
        "FailureRatio": 1.0,
        "SamplingDurationSeconds": 60,
        "BreakDurationSeconds": 30
      }
    },
    "Download": {
      "IdleSeconds": 60
    },
    "DownloadMaxMinutes": 20,
    "MaxVideoBytes": 2147483648,
    "MaxSubtitleBytes": 2097152,
    // 09.6.3-T2 (WT45, S57 review S1): the ingest spools each output into a private temp file (mode 0600) before
    // it is verified and uploaded; the directory is created owner-only if missing and write-probed at boot, which
    // also refuses a relative path, a symlink, or a mode with any group/other bit. The key is deliberately NOT
    // pinned here: the in-code default (RenderIngestOptions.DefaultTempDirectory) resolves
    // `$NTS_HOME/tmp/render-ingest` when NTS_HOME is set, and `<platform temp>/nts-render-ingest` otherwise —
    // `/tmp/nts-render-ingest` on Linux, where /tmp is often a RAM-backed tmpfs shared by every local account.
    // Production SHOULD set NTS_HOME or Render__Ingest__TempDirectory to a service-owned directory on disk. An
    // operator who overrides `Render__Ingest__TempDirectory` MUST give an absolute path, pre-create the directory
    // mode 0700 for the Worker's account, and must not point it at a link or a shared `/tmp` path.
    // 09.6.3-T1 (BD7, WF07/W12): the poll tick's cadence (10 s - a BackgroundService, never Hangfire's 15 s
    // minimum recurring job), the non-terminal timeout and the queue alarm in minutes, and one tick's caps.
    // Every value has an in-code default in RenderOptions; an out-of-range one fails the Worker's boot.
    "PollSeconds": 10,
    "MaxMinutes": 60,
    "QueueAlertMinutes": 360,
    "PollBatchSize": 50,
    "PollParallelism": 4
  },
  // 09.6.3-T2 (WT56): the retention stamped on an asset whose episode the owner has not approved yet, until
  // 09.7.3-T1's sweep deletes it; the approve path re-stamps the same rows with Assets:RetentionDays (09.7.1-T1).
  // Both windows have in-code defaults and are validated at boot (1..365 days for the approved one); this
  // section is the one an operator tunes to change how long an accepted cut is kept.
  "Assets": {
    "RetentionDays": 30,
    "UnapprovedRetentionDays": 30
  },
  "RenderNodes": {
    "HealthPollSeconds": 30,
    "DownAfterSeconds": 120,
    "HealthStaleSeconds": 90,
    "DriftAlertPulls": 3
  },
  "Outbox": {
    "PollIntervalSeconds": 5,
    "BatchSize": 20,
    "LeaseMinutes": 5,
    "MaxAttempts": 10
  },
  "Storage": {
    "ServiceUrl": "http://127.0.0.1:8333",
    "PublicServiceUrl": "http://localhost:8333",
    "Region": "us-east-1",
    "ForcePathStyle": true,
    "AccessKey": "dev",
    "SecretKey": "dev-secret-local",
    "Buckets": {
      "Media": "nt-media-dev",
      "Public": "nt-public-dev",
      "Music": "nt-music-dev"
    },
    "PresignTtlMinutes": 15,
    "TikTokPresignTtlMinutes": 120,
    "HealthMarkerKey": "_health/storage-ready.txt",
    "HealthProbeSeconds": 30
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Hangfire": "Warning"
      }
    }
  },
  "Otlp": {
    "Enabled": true
  },
  "Otel": {
    "SampleRatio": 1.0
  },
  "HealthChecks": {
    "DbTimeoutSeconds": 5
  }
}
