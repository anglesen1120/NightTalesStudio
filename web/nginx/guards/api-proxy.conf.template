# Dev/compose API proxy (NTS_API_UPSTREAM set, e.g. http://api:8080). envsubst'ed by
# 17-nts-api-guard.sh into /etc/nginx/conf.d/nts-api-guard.inc. Never used in prod,
# where the load balancer path rules own /api, /hubs and /health.
#
# The 17- script substitutes ONLY ${NTS_API_UPSTREAM}; nginx variables pass through.
# Proxy temp paths live under /tmp (unprivileged image), so --read-only works.
location /api/ {
    proxy_pass ${NTS_API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}

location /health/ {
    proxy_pass ${NTS_API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}

# WebSocket (SignalR). The access log drops the query string: the single-use hub
# ticket in /hubs/*?ticket=… must never be logged (D8/WR13).
location /hubs/ {
    proxy_pass ${NTS_API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    access_log /dev/stdout nts_noquery;
}
