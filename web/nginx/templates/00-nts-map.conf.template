# NightTales web — http-context extras (envsubst'ed into /etc/nginx/conf.d/00-nts-map.conf).
#
# NOTE on envsubst safety (WR13): the Dockerfile sets NGINX_ENVSUBST_FILTER=^NTS_, so the
# image's 20-envsubst-on-templates.sh substitutes ONLY environment variables whose name
# starts with NTS_. nginx's own $host/$uri/$http_* — and any unrelated environment
# variable that happens to share such a name — pass through untouched.
#
# WebSocket Connection header mapping for /hubs/ (api-proxy guard, dev/compose only).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
#
# Access-log format WITHOUT the query string: the single-use hub ticket in
# /hubs/*?ticket=… must never reach the log (D8/WR13). $uri is path-only.
log_format nts_noquery '$remote_addr - $remote_user [$time_local] '
                       '"$request_method $uri $server_protocol" '
                       '$status $body_bytes_sent "$http_referer" "$http_user_agent"';
