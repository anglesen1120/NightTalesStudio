{
  "name": "web",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1 --port 4200 --proxy-config proxy.conf.json",
    "build": "ng build",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "test:tools": "node --test tools/web",
    "e2e": "playwright test",
    "budget:gzip": "node tools/web/check-gzip-budget.mjs --dir dist/web/browser",
    "lint": "ng lint && node tools/web/lint-forbidden-patterns.mjs && node tools/web/check-lint-fixtures.mjs",
    "lint:app": "ng lint",
    "lint:forbidden": "node tools/web/lint-forbidden-patterns.mjs",
    "lint:fixtures": "node tools/web/check-lint-fixtures.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.2.1",
    "@angular/cdk": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/material": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/platform-server": "22.2.1",
    "@angular/router": "22.2.1",
    "@angular/ssr": "22.2.1",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@jsverse/transloco": "8.4.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.12.0",
    "axe-core": "^4.13.0",
    "angular-eslint": "22.5.0",
    "eslint": "10.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^26.10.0"
  }
}
