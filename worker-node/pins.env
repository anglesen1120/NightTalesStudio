# worker-node/pins.env — the only place versions live (README D2).
# Resolved 2026-09-25 by TL-agent; facts re-checked at these SHAs (01.1.1-T2).
# VIENEU_CODEC_REPO is the ONNX codec that the pinned code loads on the Mac ONNX path
# (onnx_runtime_lite.py:41 _CODEC_REPO); the PyTorch path uses ...-Nano (01 CR-12).
MPT_REPO=https://github.com/harry0703/MoneyPrinterTurbo.git
MPT_COMMIT=3d5f4e421927d61f3eac729cf4b711ac0b69d688
MPT_PYTHON=3.11
VIENEU_REPO=https://github.com/pnnbao97/VieNeu-TTS.git
VIENEU_COMMIT=c1390abbdb2eedcdf58eafb546966c06ce27af71
VIENEU_PYTHON=3.12
VIENEU_MODEL_REPO=pnnbao-ump/VieNeu-TTS-v3-Turbo
VIENEU_MODEL_REVISION=61b85e3d937fbbacb387714180e8182823512523
VIENEU_CODEC_REPO=OpenMOSS-Team/MOSS-Audio-Tokenizer-Nano-ONNX
VIENEU_CODEC_REVISION=ceff0d0749bfb3fa2d61149794ec6feef0d1e1ae
WHISPER_MODEL_REPO=mobiuslabsgmbh/faster-whisper-large-v3-turbo
WHISPER_MODEL_REVISION=0a363e9161cbc7ed1431c9597a8ceaf0c4f78fcf
# VieNeu proxy interpreter (04 CR-3).
PROXY_PYTHON=3.12
# OpenAI-compatible upstream for story + image calls (01 DEC-9, owner 2026-09-25): a third-party
# relay, not api.openai.com. The usage tap forwards here; start-mpt-api.sh --no-tap points MPT here.
OPENAI_BASE_URL=https://api.aixingialaire.shop/v1
# Image path and reasoning effort (01 DEC-11, owner 2026-09-25). The relay's images/generations is broken
# for the image key; OPENAI_IMAGE_API=responses makes the tap translate MPT's images/generations call into
# POST /v1/responses with the image_generation tool on OPENAI_IMAGE_HOST_MODEL. Efforts: none|minimal|low|medium|high|xhigh.
OPENAI_IMAGE_API=responses
OPENAI_IMAGE_HOST_MODEL=gpt-6-luna
OPENAI_EFFORT_IMAGE_HOST=low
# Chat effort = medium (owner 2026-09-25): on the Mac trial MPT writes the story script itself via chat
# (generate_script) when no video_script is sent; low writes poorly. Image host stays low. The pin is global:
# MPT generate_terms (1-3 word stock terms) also runs at medium; the tap cannot tell the calls apart without
# reading prompts (D6 forbids it). Accepted: terms calls are small.
OPENAI_EFFORT_CHAT=medium
