# nts-vieneu-proxy environment (04 README D13). Values shown are the defaults; required
# keys are left blank. Secrets come from the Keychain (Mac: secrets.sh init-local) or the
# node secret store (EnvironmentFile=/etc/nts/vieneu-proxy.env, 0640 root:nts-proxy) —
# they are NEVER committed.
#
# PROXY_API_KEY=            # required, >= 32 chars — set via Keychain/node secret store, never committed
# VIENEU_API_KEY=           # required, >= 32 chars — set via Keychain/node secret store, never committed
# VOICE_CATALOG_FILE=       # required — Mac: $NTS_REPO_ROOT/seed/voices.v1.json
                            # node: /opt/nts/current/seed/voices.v1.json
PROXY_HOST=127.0.0.1        # must be 127.0.0.1 (any other host -> exit 2)
PROXY_PORT=8001
VIENEU_BASE_URL=http://127.0.0.1:8000   # must be http://127.0.0.1:<port>, no path
MP3_BITRATE=192k            # 128k | 160k | 192k
UPSTREAM_CONNECT_TIMEOUT_S=5            # 1-30
UPSTREAM_READ_GAP_S=60                  # 10-100
FIRST_AUDIO_DEADLINE_S=90               # 10-100, > ADMISSION_WAIT_S
ADMISSION_WAIT_S=80                     # 0-80
REQUEST_MAX_S=1800                      # 60-3600
PROXY_MAX_CONCURRENT=4                  # 1-32 (Mac start script sets 2)
CATALOG_CHECK_INTERVAL_S=300            # 30-3600
FFMPEG_PATH=ffmpeg          # resolved via shutil.which; missing -> health ffmpeg_missing (not exit 2)
                            # node: /usr/bin/ffmpeg
